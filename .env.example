# Environment Configuration for Khujand Fortress Museum Ticketing
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
PAYMENT_MODE=sandbox
FORCE_SANDBOX=true

# Security & Cryptographic Secrets
TICKET_SIGNING_SECRET=khujand-fortress-museum-secret-salt-2026
WEBHOOK_SECRET=whsec_khujand_museum_mock_webhook_key_9981

# Tajikistan Local Payment Gateways (Sandbox / Demo)
ALIF_MERCHANT_ID=alif_merch_khujand_demo
ALIF_API_KEY=alif_sk_demo_token
ALIF_API_URL=https://api.alif.tj/v1
KORTI_MILLI_MERCHANT_ID=km_demo_030018492
KORTI_MILLI_SECRET_KEY=km_sec_demo_key
DUSHANBE_CITY_MERCHANT_ID=dc_merch_khujand_demo
DUSHANBE_CITY_API_KEY=dc_sk_demo_key

# International Gateways (Stripe)
STRIPE_PUBLISHABLE_KEY=pk_test_sample_stripe_publishable_key
STRIPE_SECRET_KEY=sk_test_sample_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_sample_stripe_webhook_secret

# E-Ticket & Receipt Dispatcher (Email)
EMAIL_ADAPTER=mock
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=demo_user
SMTP_PASS=demo_password
TICKETS_EMAIL_FROM="Исторический Музей Худжанда" <tickets@khujand-museum.tj>
